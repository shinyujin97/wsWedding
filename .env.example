# ─────────────────────────────────────────────────────────────
# 공동작업자용 환경변수 예시.
# 이 파일을 복사해 `.env.local` 로 만들고 값을 채우세요:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── 미디어 (사진 / 영상 / 음악) ──────────────────────────────
# 사진·영상·음악은 (public repo 노출 방지를 위해) git 에 올리지 않고
# Vercel Blob 에서 로드합니다. 아래 값을 설정하면 로컬에 미디어 파일이
# 없어도 개발 서버에서 이미지/영상/음악이 정상적으로 보입니다.
# (미설정 시 media() 가 로컬 /public 경로를 찾으므로 이미지가 깨집니다.)
NEXT_PUBLIC_MEDIA_BASE=https://304umf8a11s9xgqf.public.blob.vercel-storage.com

# ── Kakao 지도 / 공유 ────────────────────────────────────────
# https://developers.kakao.com 에서 발급한 JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_javascript_key
NEXT_PUBLIC_KAKAO_APP_KEY=your_kakao_javascript_key

# ── Firebase 방명록 ─────────────────────────────────────────
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 웹 앱 SDK 설정값
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ── (관리자 전용) Vercel Blob 업로드 토큰 ────────────────────
# 미디어를 교체/추가할 때만 필요. 절대 커밋하지 마세요.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# private media (사진/영상/음악 — public repo 제외)
/public/video/*
!/public/video/main.mp4
/public/weddingImages/
/public/music/
/public/Thumbnail.jpg
/public/images/frames/mainImage.jpg
/public/images/frames/image.png
